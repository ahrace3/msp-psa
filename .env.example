# Copy to .env on the NAS. Never commit the real .env.
POSTGRES_USER=psa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=psa

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random

APP_NAME=Copeland PSA
BASE_URL=http://nas.local:8090
TIMEZONE=America/New_York

# Set once GHCR package exists. Phase 0 can also build locally.
IMAGE=ghcr.io/YOURUSER/msp-psa:latest

# Phase 1 email connector — shared mailbox, no license needed.
# Leave blank to run without it; the worker skips the poll silently.
# See README > "Email connector setup" for the Azure AD app registration steps.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=support@yourdomain.com

# Documentation layer — encrypts stored credentials at rest. Required
# before the Credentials feature can be used; nothing else breaks without it.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
